{
  "name": "solana-poolmaker-hunter",
  "version": "1.0.0",
  "description": "Solana Pool Transaction Explorer CLI",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "solana-pool-tx": "./src/index.js",
    "solana-poolmaker-hunter": "./src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "daemon": "node src/index.js --daemon",
